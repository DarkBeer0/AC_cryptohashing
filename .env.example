# Подключение к PostgreSQL (значения совпадают с docker-compose.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=records_db
POSTGRES_PORT=5433
DATABASE_URL=postgres://app:app@localhost:5433/records_db

# Сколько строк сгенерировать в таблице records (npm run seed)
SEED_ROWS=1000000
# Сколько раундов SHA-256 считать для одной записи
HASH_ROUNDS=1000
